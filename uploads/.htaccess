# Empêcher l'exécution de tout script dans le dossier des uploads.
# (Méthode compatible IONOS : pas de php_flag, qui provoque une erreur 500
#  car PHP y tourne en CGI/FastCGI et non comme module Apache.)
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh|asp|aspx)$">
    Require all denied
</FilesMatch>
Options -Indexes
